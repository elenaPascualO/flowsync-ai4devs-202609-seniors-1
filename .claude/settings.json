{
  "permissions": {
    "allow": [
      "Read(//Users/elena.pascual.otero/.nvm/versions/node/**)",
      "Read(//Users/elena.pascual.otero/.nvm/alias/**)",
      "Read(//opt/homebrew/Cellar/node/26.9.0/bin/**)",
      "Read(//usr/local/bin/**)",
      "Bash(git checkout *)",
      "Read(//tmp/**)",
      "Skill(update-config)",
      "Bash(echo \"exit=$?\")"
    ]
  },
  "enabledMcpjsonServers": [
    "atlassian"
  ],
  "statusLine": {
    "type": "command",
    "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/statusline.sh",
    "padding": 0
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/log-prompt.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/log-outcome.py",
            "async": true,
            "timeout": 180
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Formateando frontend con Prettier...",
            "timeout": 30,
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path // empty' | { read -r f; case \"$f\" in \"$CLAUDE_PROJECT_DIR\"/frontend/*) cd \"$CLAUDE_PROJECT_DIR/frontend\" && ./node_modules/.bin/prettier --write --ignore-unknown \"$f\";; esac; } 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
